# ------------------------------------------------------------------
#  Adiba Sheikh Student Portal - server settings
#  Edit with Notepad / VS Code, save, then restart the server
# ------------------------------------------------------------------

# Port of the API server (the React app finds it automatically)
PORT=5000

# MongoDB connection URL - the same one you use in MongoDB Compass.
# The database and the "users" collection are created automatically
# on the first signup.
#
# Local MongoDB (Compass "localhost:27017"):
MONGO_URI=mongodb://127.0.0.1:27017/student_portal
#
# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/student_portal

# Database name used only when MONGO_URI does not include one
DB_NAME=student_portal

# Secret used to sign login tokens. Any long random text.
JWT_SECRET=change-this-to-a-long-random-secret-text
JWT_EXPIRES_IN=7d
